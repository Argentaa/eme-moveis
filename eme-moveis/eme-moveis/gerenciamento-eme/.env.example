# ============================================================
# Variaveis de ambiente para o docker-compose.yml
# Copie este arquivo para ".env" na raiz do projeto e ajuste os valores.
# NUNCA versione o arquivo ".env" real (com segredos) no Git.
# ============================================================

# Banco de dados MySQL
DB_NAME=emebd
DB_USER=eme_user
DB_PASSWORD=TROQUE_ESTA_SENHA
MYSQL_ROOT_PASSWORD=TROQUE_ESTA_SENHA_ROOT

# Backend e JWT
# Gere com: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=GERE_UMA_CHAVE_SEGURA_DE_128_CARACTERES_AQUI
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origens permitidas pelo CORS (a porta do frontend exposta no host)
ALLOWED_ORIGINS=http://localhost:3001

# Criacao do primeiro usuario ADMIN (usado so pelo servico create-admin)
ADMIN_USERNAME=admin
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@eme.com
ADMIN_PASSWORD=TROQUE_ESTA_SENHA_TAMBEM
