# ============================================================
# Configuração do Backend EME Móveis
# Copie este arquivo como .env e preencha com valores reais
# ============================================================

# Banco de dados MySQL (XAMPP ou servidor dedicado)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=eme_user
DB_PASSWORD=SUA_SENHA_MYSQL_AQUI
DB_NAME=emebd

# JWT — Gere com: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=GERE_UMA_CHAVE_SEGURA_AQUI
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origens permitidas pelo CORS (separar por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
