# Modelo de variáveis — EME Móveis (Dokploy: cole no painel Environment).
# Gere segredos novos; NUNCA reutilize os .env que vieram no zip original.
#   python3 -c "import secrets; print(secrets.token_hex(64))"

# --- Banco (serviço db interno) ---
POSTGRES_DB=eme
POSTGRES_USER=eme
POSTGRES_PASSWORD=TROQUE_AQUI_senha_forte_do_postgres

# --- ERP backend ---
# 128 chars hex (obrigatório: chave curta gera warning e sessão fraca)
ERP_SECRET_KEY=TROQUE_AQUI_128_hex
ERP_JWT_MINUTES=720
ERP_CORS_ORIGINS=*
ERP_ADMIN_USER=admin
ERP_ADMIN_NAME=Administrador
ERP_ADMIN_EMAIL=admin@ememoveis.com.br
ERP_ADMIN_PASSWORD=TROQUE_AQUI_senha_admin_erp

# --- Site backend (segredo DIFERENTE do ERP) ---
SITE_JWT_SECRET=TROQUE_AQUI_outro_128_hex
SITE_ADMIN_USER=admin
SITE_ADMIN_PASS=TROQUE_AQUI_senha_admin_site
